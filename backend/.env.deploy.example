OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

FRONTEND_ORIGIN=https://novicereader.com
FRONTEND_ORIGINS=https://novicereader.com,https://www.novicereader.com
FRONTEND_ORIGIN_REGEX=
PUBLIC_BACKEND_ORIGIN=https://novicereader.com

AUTH_SECRET_KEY=replace_with_output_of_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REGISTRATION_CODE=replace_with_private_invite_code

# Docker Compose injects DATABASE_URL from the root .env POSTGRES_PASSWORD.
DATABASE_URL=
PDF_STORAGE_BACKEND=local

# Keep these empty while PDFs are stored on the VPS disk.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=novicereader
